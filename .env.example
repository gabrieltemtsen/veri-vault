# VeriVault Optional Environment Configuration
# All tests, simulations, and UI flows run 100% deterministically with zero external keys required.
# Provide the optional keys below to enable live NEAR AI Cloud TEE completions and authenticated 1Click API quotes.

# NEAR AI Cloud (https://cloud.near.ai / https://nearbuilders.org/dashboard)
NEAR_AI_CLOUD_API_KEY=
NEAR_AI_CLOUD_BASE_URL=https://cloud-api.near.ai/v1

# NEAR Intents 1Click API (https://partners.near-intents.org)
# Optional JWT; dry: true quotes work without a JWT (0.2% unauthenticated fee tier)
ONECLICK_API_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# NEAR RPC & Contract Identifiers
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
MASTER_VAULT_CONTRACT_ID=verivault.near
POLICY_GUARD_CONTRACT_ID=policy-guard.verivault.near
NEAR_INTENTS_VERIFIER_ID=verifier.near
NEAR_MPC_SIGNER_ID=v1.signer
